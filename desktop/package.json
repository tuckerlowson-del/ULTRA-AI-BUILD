{
  "name": "one-brain-desktop",
  "version": "0.7.0",
  "private": true,
  "description": "ONE BRAIN AI workspace and computer operator",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "start": "concurrently -k \"npm:dev\" \"npm:desktop\"",
    "build": "vite build",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1 && npm run build && electron-builder --win nsis --publish always",
    "dist:dir": "npm run build && electron-builder --win dir",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5",
    "@capacitor/cli": "^6.2.1"
  },
  "build": {
    "appId": "com.tuckerlowson.onebrain",
    "productName": "ONE BRAIN",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ONE-BRAIN-Setup-${version}.${ext}",
      "icon": "assets/onebrain.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "shortcutName": "ONE BRAIN"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tuckerlowson-del",
        "repo": "ULTRA-AI-BUILD",
        "releaseType": "release"
      }
    ]
  }
}
